# Copy this file to .env before running `docker compose up -d`
# The backend reads the DATABASE_* variables, so point them at your MySQL server.

# ---------- App ----------
APP_ADDRESS=0.0.0.0
APP_PORT=8080
# Port published by the frontend container on the host
FRONTEND_PORT=80
GIN_MODE=release

# Public URL of the frontend (used by Google OAuth redirect)
FRONTEND_URL=http://localhost
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost

# ---------- Database ----------
# "db" is the bundled MariaDB (MySQL-compatible) container from docker-compose.yml.
# Change to host.docker.internal or another hostname to use an external MySQL server.
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=kilas
DATABASE_USERNAME=kilas
DATABASE_PASSWORD=change-me
# Root password for the bundled database container (not used by the app)
DATABASE_ROOT_PASSWORD=change-me-root

# ---------- Auth ----------
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

# ---------- Google OAuth (optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost/api/auth/google/callback

# ---------- AI (optional) ----------
GEMINI_API_KEY=

# ---------- Midtrans payments (optional) ----------
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
